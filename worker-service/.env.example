# =============================================================================
# WORKER SERVICE CONFIGURATION
# =============================================================================
# Copy this file to .env and update values as needed
# Command: cp .env.example .env

# -----------------------------------------------------------------------------
# Worker Settings
# -----------------------------------------------------------------------------
WORKER_NAME=embedding-worker
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# -----------------------------------------------------------------------------
# Qdrant Vector Database Settings
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=your-api-key-here  # Optional, uncomment if using authentication

# -----------------------------------------------------------------------------
# Kafka Message Queue Settings
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=embedding-requests
KAFKA_GROUP_ID=embedding-worker-group
KAFKA_AUTO_OFFSET_RESET=earliest
# Options: earliest (from beginning), latest (new messages only)

# -----------------------------------------------------------------------------
# Embedding Model Settings
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=jinaai/jina-embeddings-v3
EMBEDDING_TASK=retrieval.passage
VECTOR_SIZE=1024
# Vietnamese-SBERT: PhoBERT-based model optimized for Vietnamese
# Vector size: 768 dimensions (changed from 384 for better quality)
# 
# Alternatives:
#   - VoVanPhuc/sup-SimCSE-VietNamese-phobert-base (768 dim, max accuracy)
#   - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384 dim, multilingual)

# -----------------------------------------------------------------------------
# Processing Settings
# -----------------------------------------------------------------------------
BATCH_SIZE=100
# Number of messages to process in one batch
# Higher = better throughput, more memory usage

BATCH_TIMEOUT=5
# Timeout in seconds to wait for batch to fill
# Lower = faster processing, less batching efficiency

# =============================================================================
# NOTES:
# =============================================================================
# 1. For Docker deployment, change hosts to service names:
#    QDRANT_HOST=qdrant
#    KAFKA_BOOTSTRAP_SERVERS=kafka:29092
#
# 2. For production, consider:
#    - Setting LOG_LEVEL=WARNING or ERROR
#    - Increasing BATCH_SIZE for better throughput
#    - Setting QDRANT_API_KEY for security
#    - Using multiple workers with same KAFKA_GROUP_ID
#
# 3. For debugging:
#    - Set LOG_LEVEL=DEBUG
#    - Reduce BATCH_SIZE=10 for easier tracking
#    - Reduce BATCH_TIMEOUT=1 for faster feedback
#
# 4. All settings have defaults in app/config.py
#    Only override what you need to change
#
# 5. First run will download embedding model (~420MB)
#    Subsequent runs will use cached model
#
# 6. IMPORTANT: Vector size changed from 384 to 768
#    You need to recreate Qdrant collections and re-embed all data
# =============================================================================
