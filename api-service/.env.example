# =============================================================================
# API SERVICE CONFIGURATION
# =============================================================================
# Copy this file to .env and update values as needed
# Command: cp .env.example .env

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------
API_TITLE=Semantic Search API
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# Qdrant Vector Database Settings
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=your-api-key-here  # Optional, uncomment if using authentication

# -----------------------------------------------------------------------------
# Kafka Message Queue Settings
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=embedding-requests

# -----------------------------------------------------------------------------
# Embedding Model Settings
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=keepitreal/vietnamese-sbert
# Best Vietnamese embedding model (PhoBERT-based, 768 dimensions)
# Alternatives:
#   - VoVanPhuc/sup-SimCSE-VietNamese-phobert-base (max accuracy)
#   - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (multilingual, 384 dim)

# =============================================================================
# NOTES:
# =============================================================================
# 1. For Docker deployment, change hosts to service names:
#    QDRANT_HOST=qdrant
#    KAFKA_BOOTSTRAP_SERVERS=kafka:29092
#
# 2. For production, consider:
#    - Setting QDRANT_API_KEY for security
#    - Using external Kafka cluster
#    - Enabling HTTPS/TLS
#
# 3. All settings have defaults in app/config.py
#    Only override what you need to change
# =============================================================================


# Redis Cache
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# Custom files
CUSTOM_SYNONYMS_FILE=config/custom_synonyms.json
CUSTOM_ABBREVIATIONS_FILE=config/custom_abbreviations.json